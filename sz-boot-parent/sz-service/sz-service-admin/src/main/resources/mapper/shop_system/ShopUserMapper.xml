<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sz.admin.shop_system.mapper.ShopUserMapper">
    <!-- 通用映射 -->
    <resultMap id="BaseResultMap" type="com.sz.admin.shop_system.pojo.po.ShopUser">
        <id column="uid" property="uid"/>
        <result column="account" property="account" />
        <result column="password" property="password" />
        <result column="real_name" property="realName" />
        <result column="sex" property="sex" />
        <result column="birthday" property="birthday" />
        <result column="card_id" property="cardId" />
        <result column="nickname" property="nickname" />
        <result column="avatar" property="avatar" />
        <result column="phone" property="phone" />
        <result column="add_ip" property="addIp" />
        <result column="last_ip" property="lastIp" />
        <result column="now_money" property="nowMoney" />
        <result column="integral" property="integral" />
        <result column="experience" property="experience" />
        <result column="sign_num" property="signNum" />
        <result column="level" property="level" />
        <result column="user_type" property="userType" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="status" property="status" />
    </resultMap>

    <resultMap id="ShopUserVOResultMap" type="com.sz.admin.shop_system.pojo.vo.ShopUserVO">
        <id column="uid" property="uid"/>
        <result column="account" property="account" />
        <result column="password" property="password" />
        <result column="real_name" property="realName" />
        <result column="sex" property="sex" />
        <result column="birthday" property="birthday" />
        <result column="card_id" property="cardId" />
        <result column="nickname" property="nickname" />
        <result column="avatar" property="avatar" />
        <result column="phone" property="phone" />
        <result column="add_ip" property="addIp" />
        <result column="last_ip" property="lastIp" />
        <result column="now_money" property="nowMoney" />
        <result column="integral" property="integral" />
        <result column="experience" property="experience" />
        <result column="sign_num" property="signNum" />
        <result column="level" property="level" />
        <result column="user_type" property="userType" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="status" property="status" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        uid, account, password, real_name, sex, birthday, card_id, nickname, avatar, phone, add_ip, last_ip, now_money, integral, experience, sign_num, level, user_type, create_time, update_time, status
    </sql>

    <select id="countByUid" resultType="long">
        SELECT COUNT(*)
        FROM shop_user
        WHERE uid = #{uid}
    </select>

    <select id="countByAccount" resultType="long">
        SELECT COUNT(*)
        FROM shop_user
        WHERE account = #{account}
        <if test="excludeUid != null">
            AND uid != #{excludeUid}
        </if>
    </select>

    <select id="countByCardId" resultType="long">
        SELECT COUNT(*)
        FROM shop_user
        WHERE card_id = #{cardId}
        <if test="excludeUid != null">
            AND uid != #{excludeUid}
        </if>
    </select>

    <select id="countByPhone" resultType="long">
        SELECT COUNT(*)
        FROM shop_user
        WHERE phone = #{phone}
        <if test="excludeUid != null">
            AND uid != #{excludeUid}
        </if>
    </select>

    <select id="selectOneByAccount" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM shop_user
        WHERE account = #{account}
        LIMIT 1
    </select>

    <select id="selectOneByPhone" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM shop_user
        WHERE phone = #{phone}
        LIMIT 1
    </select>

    <select id="selectUserList" resultMap="ShopUserVOResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM shop_user
        <where>
            <if test="dto != null">
                <if test="dto.account != null and dto.account.trim() != ''">
                    AND account LIKE CONCAT('%', #{dto.account}, '%')
                </if>
                <if test="dto.realName != null and dto.realName.trim() != ''">
                    AND real_name LIKE CONCAT('%', #{dto.realName}, '%')
                </if>
                <if test="dto.sex != null">
                    AND sex = #{dto.sex}
                </if>
                <if test="dto.cardId != null and dto.cardId.trim() != ''">
                    AND card_id = #{dto.cardId}
                </if>
                <if test="dto.nickname != null and dto.nickname.trim() != ''">
                    AND nickname LIKE CONCAT('%', #{dto.nickname}, '%')
                </if>
                <if test="dto.phone != null and dto.phone.trim() != ''">
                    AND phone = #{dto.phone}
                </if>
                <if test="dto.status != null">
                    AND status = #{dto.status}
                </if>
            </if>
        </where>
    </select>

</mapper>

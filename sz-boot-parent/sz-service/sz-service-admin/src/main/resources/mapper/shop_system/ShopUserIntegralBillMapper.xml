<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sz.admin.shop_system.mapper.ShopUserIntegralBillMapper">
    <!-- 通用映射 -->
    <resultMap id="BaseResultMap" type="com.sz.admin.shop_system.pojo.po.ShopUserIntegralBill">
        <id column="id" property="id"/>
        <result column="uid" property="uid" />
        <result column="link_id" property="linkId" />
        <result column="pm" property="pm" />
        <result column="title" property="title" />
        <result column="category" property="category" />
        <result column="type" property="type" />
        <result column="number" property="number" />
        <result column="balance" property="balance" />
        <result column="mark" property="mark" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="status" property="status" />
    </resultMap>

    <resultMap id="ShopFrontUserIntegralBillVOResultMap" type="com.sz.admin.shop_system.pojo.vo.ShopFrontUserIntegralBillVO">
        <id column="id" property="id"/>
        <result column="link_id" property="linkId" />
        <result column="pm" property="pm" />
        <result column="title" property="title" />
        <result column="type" property="type" />
        <result column="number" property="number" />
        <result column="balance" property="balance" />
        <result column="mark" property="mark" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, uid, link_id, pm, title, category, type, number, balance, mark, create_time, update_time, status
    </sql>

    <select id="selectFrontIntegralBillList" resultMap="ShopFrontUserIntegralBillVOResultMap">
        SELECT id, link_id, pm, title, type, number, balance, mark, create_time
        FROM shop_user_integral_bill
        WHERE uid = #{uid}
          AND category = #{category}
        ORDER BY create_time DESC, id DESC
    </select>

    <select id="sumPositiveNumberByUidAndCategoryAndPm" resultType="java.lang.Integer">
        SELECT COALESCE(SUM(number), 0)
        FROM shop_user_integral_bill
        WHERE uid = #{uid}
          AND category = #{category}
          AND pm = #{pm}
          AND number &gt; 0
    </select>

</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sz.admin.shop_system.mapper.ShopHomeNewsCategoryMapper">
    <!-- 通用映射 -->
    <resultMap id="BaseResultMap" type="com.sz.admin.shop_system.pojo.po.ShopHomeNewsCategory">
        <id column="id" property="id"/>
        <result column="category_name" property="categoryName"/>
        <result column="sort" property="sort"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_del" property="isDel"/>
        <result column="version" property="version"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, category_name, sort, status, remark, create_time, update_time, is_del, version
    </sql>

    <sql id="VO_Column_List">
        id, category_name, sort, status, remark, create_time
    </sql>

    <select id="selectCategoryList" resultType="com.sz.admin.shop_system.pojo.vo.ShopHomeNewsCategoryVO">
        SELECT
        <include refid="VO_Column_List"/>
        FROM shop_home_news_category
        <where>
            <if test="query != null and query.categoryName != null and query.categoryName.trim() != ''">
                AND category_name LIKE CONCAT('%', #{query.categoryName}, '%')
            </if>
            <if test="query != null and query.status != null">
                AND status = #{query.status}
            </if>
        </where>
        ORDER BY sort ASC, id ASC
    </select>

    <select id="selectFrontCategoryList" resultType="com.sz.admin.shop_system.pojo.vo.ShopHomeNewsCategoryVO">
        SELECT
        <include refid="VO_Column_List"/>
        FROM shop_home_news_category
        WHERE is_del = 0
          AND status = 0
        ORDER BY sort ASC, id ASC
    </select>

</mapper>

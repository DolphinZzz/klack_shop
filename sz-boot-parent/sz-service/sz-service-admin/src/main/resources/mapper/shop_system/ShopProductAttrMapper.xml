<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sz.admin.shop_system.mapper.ShopProductAttrMapper">
    <!-- 通用映射 -->
    <resultMap id="BaseResultMap" type="com.sz.admin.shop_system.pojo.po.ShopProductAttr">
        <id column="id" property="id"/>
        <result column="product_id" property="productId"/>
        <result column="attr_name" property="attrName"/>
        <result column="attr_values" property="attrValues"/>
        <result column="type" property="type"/>
        <result column="is_del" property="isDel"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, product_id, attr_name, attr_values, type, is_del
    </sql>

    <select id="selectAttrList" resultType="com.sz.admin.shop_system.pojo.vo.ShopProductAttrVO">
        SELECT id, product_id, attr_name, is_del
        FROM shop_product_attr
    </select>

    <select id="selectByProductIdAndType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM shop_product_attr
        WHERE product_id = #{productId}
          AND type = #{type}
          AND is_del = 0
    </select>

    <select id="selectByProductId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM shop_product_attr
        WHERE product_id = #{productId}
    </select>

    <delete id="deleteByProductId">
        DELETE FROM shop_product_attr
        WHERE product_id = #{productId}
    </delete>

    <delete id="deleteByProductIds">
        DELETE FROM shop_product_attr
        WHERE product_id IN
        <foreach collection="productIds" item="productId" open="(" separator="," close=")">
            #{productId}
        </foreach>
    </delete>

</mapper>

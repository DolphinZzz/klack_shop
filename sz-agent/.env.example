# 服务与内部安全配置（仅绑定本地内网接口）
APP_HOST=127.0.0.1
APP_PORT=8000
AGENT_INTERNAL_SECRET=kada-local-internal-secret
JAVA_INTERNAL_BASE_URL=http://127.0.0.1:9991/api
JAVA_INTERNAL_TIMEOUT_SECONDS=15

# PostgreSQL 与 Milvus 配置
POSTGRES_DSN=postgresql+asyncpg://kada:kada_pass@127.0.0.1:5432/kada_cs
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=kada_cs_kb_chunks

# 大语言模型（DeepSeek）与向量嵌入模型（DashScope Qwen）配置
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSIONS=1024

# MinerU 解析与知识库存储配置
MINERU_MODE=cloud_api
MINERU_API_TOKEN=
MINERU_BASE_URL=
KB_STORAGE_DIR=./storage/kb_docs
